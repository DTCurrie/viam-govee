{
  "$schema": "https://dl.viam.dev/module.schema.json",
  "module_id": "dtcurrie:viam-govee",
  "visibility": "public",
  "url": "https://github.com/DTCurrie/viam-govee",
  "description": "Govee smart device control module for Viam",
  "models": [
    {
      "api": "rdk:component:switch",
      "model": "dtcurrie:viam-govee:govee-light-switch",
      "short_description": "Govee light on/off control",
      "markdown_link": "README.md#govee-light-switch"
    },
    {
      "api": "rdk:component:switch",
      "model": "dtcurrie:viam-govee:govee-light-brightness",
      "short_description": "Govee light brightness control (0-100%)",
      "markdown_link": "README.md#govee-light-brightness"
    },
    {
      "api": "rdk:component:switch",
      "model": "dtcurrie:viam-govee:govee-light-color",
      "short_description": "Govee light RGB color channel control",
      "markdown_link": "README.md#govee-light-color"
    },
    {
      "api": "rdk:component:switch",
      "model": "dtcurrie:viam-govee:govee-light-scene",
      "short_description": "Govee dynamic scene selection per light",
      "markdown_link": "README.md#govee-light-scene"
    },
    {
      "api": "rdk:component:switch",
      "model": "dtcurrie:viam-govee:govee-light-color-temp",
      "short_description": "Govee light color temperature control",
      "markdown_link": "README.md#govee-light-color-temp"
    },
    {
      "api": "rdk:component:switch",
      "model": "dtcurrie:viam-govee:govee-light-diy-scene",
      "short_description": "Govee user-created DIY scene selection per light",
      "markdown_link": "README.md#govee-light-diy-scene"
    },
    {
      "api": "rdk:component:switch",
      "model": "dtcurrie:viam-govee:govee-light-snapshot",
      "short_description": "Govee saved snapshot activation per light",
      "markdown_link": "README.md#govee-light-snapshot"
    },
    {
      "api": "rdk:service:discovery",
      "model": "dtcurrie:viam-govee:govee-discovery",
      "short_description": "Govee device discovery service",
      "markdown_link": "README.md#govee-discovery"
    },
    {
      "api": "rdk:component:sensor",
      "model": "dtcurrie:viam-govee:govee-light-sensor",
      "short_description": "Govee light state and color sensor readings",
      "markdown_link": "README.md#govee-light-sensor"
    },
    {
      "api": "rdk:component:switch",
      "model": "dtcurrie:viam-govee:govee-plug-switch",
      "short_description": "Govee smart plug on/off control",
      "markdown_link": "README.md#govee-plug-switch"
    },
    {
      "api": "rdk:component:sensor",
      "model": "dtcurrie:viam-govee:govee-plug-sensor",
      "short_description": "Govee smart plug state sensor readings",
      "markdown_link": "README.md#govee-plug-sensor"
    }
  ],
  "entrypoint": "bin/viam-govee",
  "first_run": "",
  "build": {
    "build": "make module.tar.gz",
    "setup": "make setup",
    "path": "module.tar.gz",
    "arch": ["linux/amd64", "linux/arm64", "darwin/arm64", "windows/amd64"]
  }
}
